# =============================================================================
# BatteryBoi-Recharged — Secrets Inventory (Documentation Only)
# =============================================================================
# No .env files are used in this project. All secrets are managed via Doppler.
#
# Setup:
#   1. Install Doppler CLI:  brew install dopplerhq/cli/doppler
#   2. Authenticate:         doppler login
#   3. Select project:       doppler setup   (uses doppler.yaml defaults)
#   4. Run commands:         doppler run -- bundle exec fastlane build
#
# Environments:
#   dev  — local development (task build, task release, task certs:sync)
#   ci   — GitHub Actions CI (build verification, Sentry staging)
#   prd  — production releases (signing, notarization, Sparkle, Sentry)
#
# See docs/CI-CD-SETUP.md for the full setup guide.
# =============================================================================

# --- Apple Developer (signing & notarization) ---
APPLE_TEAM_ID=                      # Apple Developer Team ID (dev, ci, prd)
APPLE_ID=                           # Apple ID email for notarization (prd only)
APPLE_APP_PASSWORD=                 # App-specific password for notarization (prd only)

# --- Fastlane Match (code signing certificates) ---
MATCH_GIT_URL=                      # URL to ios-certs private repo (dev, ci, prd)
MATCH_PASSWORD=                     # Encryption password for certs (dev, ci, prd)
MATCH_GIT_BASIC_AUTHORIZATION=      # Base64-encoded github_user:PAT (dev, ci, prd)

# --- Sparkle (auto-updates) ---
SPARKLE_PRIVATE_KEY=                # EdDSA private key for signing DMGs (prd only)

# --- Sentry (error tracking) ---
SENTRY_AUTH_TOKEN=                  # Sentry API auth token (ci, prd)
SENTRY_ORG=                         # Sentry organization slug (ci, prd)
SENTRY_PROJECT=                     # Sentry project slug (ci, prd)

# --- GitHub-managed tokens (NOT in Doppler) ---
# GITHUB_TOKEN              — Auto-provided by GitHub Actions
# SEMANTIC_RELEASE_PAT      — GitHub PAT for semantic-release (GitHub secret)
# HOMEBREW_GITHUB_API_TOKEN — GitHub PAT for brew bump-cask-pr (GitHub secret)
# DOPPLER_CI_TOKEN          — Doppler service token for ci config (GitHub secret)
# DOPPLER_PRD_TOKEN         — Doppler service token for prd config (GitHub secret)
